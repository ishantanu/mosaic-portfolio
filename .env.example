# Choose one mode. Demo mode is safe for product demonstrations and does not
# call any broker. Set this to false when using a real Trading 212 account.
MOSAIC_DEMO_MODE=true

# Required only when MOSAIC_DEMO_MODE=false. Never commit real credentials.
TRADING212_API_KEY=
TRADING212_SECRET_KEY=
TRADING212_ACCOUNT_ID=
# TRADING212_BASE_URL=https://live.trading212.com/api/v0
# TRADING212_ACCOUNT_SUMMARY_PATH=/equity/account/summary

# Docker host ports (the API remains private behind the web container).
WEB_PORT=8081
POSTGRES_PORT=5432

# Local Docker database defaults. Change these outside local development.
POSTGRES_USER=mosaic
POSTGRES_PASSWORD=mosaic_dev_only
POSTGRES_DB=mosaic
# DATABASE_URL=postgres://mosaic:mosaic_dev_only@postgres:5432/mosaic?sslmode=disable

# API behaviour. PORT is only needed for a native Go API server.
# PORT=8081
# CORS_ORIGIN=http://localhost:5173
BROKER_REFRESH_INTERVAL=15m

# Optional observability overlay ports and OpenTelemetry settings. The overlay
# routes traces through Grafana Alloy; it is not started by the base Compose file.
# OTEL_COLLECTOR_HTTP_PORT=4318
# FARO_PORT=12347
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# TEMPO_PORT=3200
# LOKI_PORT=3100
# VITE_FARO_URL=http://localhost:12347/collect
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-this-for-any-shared-environment
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=mosaic-api
# OTEL_TRACES_SAMPLER_ARG=1
